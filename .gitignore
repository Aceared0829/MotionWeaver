.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# IDE
.idea/
.vscode/
.codex/

# log
outputs/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

outputs/

.DS_Store

