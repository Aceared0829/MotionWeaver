# Motion/training data (large local datasets, not tracked in git)
/data/raw/
/data/prepared/
/training/runs/
/model-weight/pretrained/
/model-weight/finetuned/
/model-weight/exported/
/unreal-script/**/Binaries/
/unreal-script/**/Intermediate/
/unreal-script/**/Saved/
/unreal-script/MotionWeaverCMCPreview/Content/
/unreal-script/MotionWeaver/Content/
/unreal-sample/**/Content/
/unreal-sample/**/Binaries/
/unreal-sample/**/Intermediate/
/unreal-sample/**/Saved/
# UE sample hosts keep source and project metadata, not IDE solutions or derived data.
/unreal-sample/**/.vs/
/unreal-sample/**/DerivedDataCache/
/unreal-sample/**/*.sln
/unreal-sample/**/*.slnx
/unreal-sample/**/.vsconfig
# UBT 生成的 C++ 索引数据（本机路径与绝对路径，不入库）；.clangd 配置本身保留在版本库。
/unreal-sample/**/compile_commands.json
/unreal-sample/**/.cache/
/unreal-sample/**/.ignore
/unreal-script/**/compile_commands.json
/unreal-script/**/.cache/
# clangd fallback 用的 UHT 生成头存根，由 unreal-script/gen_compile_commands.py 重新生成。
/unreal-script/.clangd-stubs/
.clangd-index/
# UE writes local preview-lighting profiles into this file; keep functional Config/ defaults.
/unreal-sample/UMWSamplePreview/Config/DefaultEditor.ini
/motionbricks/assets/
/motionbricks/out/
/motionbricks/unreal_data/
/motionbricks/unreal_runs/
# Legacy root paths are local junctions; maintained compatibility source lives under tools/compat.
/motionbricks/
/tools/compat/motionbricks/assets/
/tools/compat/motionbricks/out/
/tools/compat/motionbricks/unreal_data/
/tools/compat/motionbricks/unreal_runs/
bones_seed_smpl/
sonic_release/
# Training output logs
logs_rl/
logs_eval/

# Local browser QA artifacts (not dataset or source)
.playwright-cli/
output/playwright/
/output/ue_animgraph*/
/output/ai_animation_runtime*/
# Local experiment outputs; explicitly unignore selected evidence when publishing.
/output/

