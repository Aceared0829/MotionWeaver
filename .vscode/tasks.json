{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: doctor",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": ["tools/dev.py", "doctor"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Dev: doctor (strict)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": ["tools/dev.py", "doctor", "--strict"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Dev: test",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": ["-m", "pytest", "tests", "-q"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Dev: test current file",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": ["-m", "pytest", "${relativeFile}", "-q"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Dev: lint",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": ["tools/dev.py", "lint"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Dev: check",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": ["tools/dev.py", "check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Dev: setup (full)",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": ["tools/dev.py", "setup", "--demo", "--export"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Dev: setup (minimal)",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": ["tools/dev.py", "setup", "--minimal"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Dev: bootstrap",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": ["tools/dev.py", "bootstrap"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "UE: generate clangd compile database",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": ["unreal-script/gen_compile_commands.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "UE: sync plugin mirror",
      "type": "process",
      "command": "pwsh",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/unreal-script/Tools/Sync-MotionWeaver.ps1"
        ]
      },
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/unreal-script/Tools/Sync-MotionWeaver.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "UE: check plugin mirror",
      "type": "process",
      "command": "pwsh",
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/unreal-script/Tools/Sync-MotionWeaver.ps1",
          "-Check"
        ]
      },
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/unreal-script/Tools/Sync-MotionWeaver.ps1",
        "-Check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "UE: check environment",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "Check"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "UE: build editor (Linux Development)",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "BuildEditor"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "UE: generate clang database",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "GenerateClangDatabase"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      // 后台监听源码清单（增删/改名/Build.cs 依赖），变化时自动重建 clangd 数据库。
      // 只在文件清单变化时重建，改内容不触发；单次约 3 秒。
      "label": "UE: watch clang database",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "WatchClangDatabase"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "UE: launch editor",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "LaunchEditor"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "UE: run plugin automation tests",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "RunTests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "UE: launch editor under gdbserver",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/ue.sh", "DebugServer"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
