{
  // 共享项目配置。个人机器差异请放在 VSCode User Settings，不要改这里的公共默认值。
  // Windows 用户若自动发现失败，手动选择 .venv\\Scripts\\python.exe。
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.venvPath": "${workspaceFolder}",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.exclude": [
    "**/.venv/**",
    "**/.build/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**",
    "**/data/raw/**",
    "**/data/prepared/**",
    "**/training/runs/**",
    "**/model-weight/**",
    "**/unreal-sample/**/Content/**",
    "**/unreal-sample/**/Binaries/**",
    "**/unreal-sample/**/Intermediate/**"
  ],
  // pytest 是唯一测试入口；测试已统一在 tests/ 下。
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.pytestArgs": ["tests"],
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  // 仓库尚未统一历史格式，禁止保存时自动格式化/整理 import。
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.ruff": "never",
    "source.organizeImports.ruff": "never"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.tabSize": 2
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "*.uproject": "json",
    "*.uplugin": "json",
    "*.usf": "cpp",
    "*.inl": "cpp",
    "*.ush": "cpp"
  },
  // UE C++ 只交给 clangd：两个语言服务器会给出互相矛盾的诊断，
  // 而 MS C++ 扩展读不懂 UBT 生成的参数。
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "clangd.arguments": [
    // 这里不要传 --compile-commands-dir：clangd 只接受一个值，写多次时最后一个
    // 生效、前面的静默丢弃。此前同时传宿主工程与 unreal-script，宿主工程的 UBT
    // 数据库被覆盖，clangd 退回没有 include 路径的兜底参数，整个插件都报
    // 「Pose/... file not found」。两个工程各自用目录下的 .clangd 指定数据库：
    // unreal-sample/AIMotionSample/.clangd -> .vscode/，
    // unreal-script/.clangd -> gen_compile_commands.py 生成的索引。
    "--background-index",
    "--header-insertion=never",
    "--completion-style=detailed",
    "--inlay-hints"
  ],
  "clangd.onConfigChanged": "restart",
  "[cpp]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": false
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/*.egg-info": true,
    // scripts/ue.sh 维护的引擎链接；不排除会让搜索/监听跟进整个引擎目录。
    "**/.vscode/ue-engine": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/.build": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/data/raw": true,
    "**/data/prepared": true,
    "**/training/runs": true,
    "**/unreal-sample/**/Content": true,
    "**/unreal-sample/**/Binaries": true,
    "**/unreal-sample/**/Intermediate": true,
    "**/unreal-sample/**/Saved": true,
    "**/unreal-sample/**/DerivedDataCache": true,
    "**/unreal-sample/**/Plugins/**/ThirdParty": true,
    "**/.vscode/ue-engine": true,
    "**/node_modules": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.venv/**": true,
    "**/.build/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/data/raw/**": true,
    "**/data/prepared/**": true,
    "**/training/runs/**": true,
    "**/model-weight/**": true,
    "**/unreal-sample/**/Content/**": true,
    "**/unreal-sample/**/Binaries/**": true,
    "**/unreal-sample/**/Intermediate/**": true,
    "**/unreal-sample/**/Saved/**": true,
    "**/unreal-sample/**/DerivedDataCache/**": true,
    "**/.vscode/ue-engine/**": true
  },
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.linux": {
    "PYTHONUTF8": "1"
  },
  "terminal.integrated.env.windows": {
    "PYTHONUTF8": "1"
  },
  "ruff.enable": true,
  "ruff.organizeImports": false,
  "ruff.fixAll": false,
  "git.ignoreLimitWarning": true
}
